#!/usr/bin/env bash
# Usage: rssh [ssh connection options] host
set -euo pipefail

if [ "$#" -eq 0 ]; then
    printf 'Usage: rssh [ssh connection options] host\n' >&2
    exit 2
fi

case "${!#}" in
    -*) printf 'rssh: put the host last\n' >&2; exit 2 ;;
esac

shell_dir="$HOME/.config/dotfiles"
remote_header="$shell_dir/remote/bashrc"
if [ ! -r "$remote_header" ]; then
    printf 'rssh: missing %s; apply your dotfiles first\n' "$remote_header" >&2
    exit 1
fi

# The remote command is static. SSH resolves the host and options using the
# normal SSH configuration; no host-derived string is evaluated as shell code.
upload_command=$(cat <<'EOF'
bash -c 'umask 077; tmp=${TMPDIR:-/tmp}; tmp=${tmp%/}; dir=$(mktemp -d "$tmp/rssh.XXXXXX") || exit; cleanup() { rm -rf -- "$dir"; }; trap cleanup EXIT; cat > "$dir/bashrc" || exit; trap - EXIT; printf "RSSH_DIR=%s\n" "$dir"'
EOF
)

if ! remote_output=$(ssh "$@" "$upload_command" < "$remote_header"); then
    printf 'rssh: could not upload the remote shell config\n' >&2
    exit 1
fi

remote_dir=${remote_output##*RSSH_DIR=}
remote_dir=${remote_dir%%[[:space:]]*}
case "$remote_dir" in
    */rssh.[A-Za-z0-9]*) ;;
    *) printf 'rssh: unexpected remote temp path\n' >&2; exit 1 ;;
esac
case "$remote_dir" in
    *..*|*[!/A-Za-z0-9._-]*) printf 'rssh: unexpected remote temp path\n' >&2; exit 1 ;;
esac

# The directory is a remote mktemp path, checked above, and passed as an argument.
# The uploaded rc sources login profiles when they are readable, then the portable aliases.
session_command=$(cat <<'EOF'
bash -c 'd=$1; tmp=${TMPDIR:-/tmp}; tmp=${tmp%/}; case "$d" in "$tmp"/rssh.*) ;; *) exit 1;; esac; cleanup() { rm -rf -- "$d"; }; trap cleanup EXIT; exec bash --rcfile "$d/bashrc" -i' _
EOF
)

ssh -tt "$@" "$session_command" "$remote_dir"
