source /opt/homebrew/share/antigen/antigen.zsh

export ZSH=$HOME/.zsh_scripts

# all zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
    source f$file
done

# load all files except path
for file in ${config_files:#*/path.zsh}
do
    source $file
done

# load local scripts should they be present
if [ -f $HOME/.zshlocals ]; then
    source $HOME/.zshlocals
fi

unset config_files

eval "$(starship init zsh)"
source <(fzf --zsh)
eval "$(zoxide init zsh)"

# bun completions
[ -s "/Users/thomasvandam/.bun/_bun" ] && source "/Users/thomasvandam/.bun/_bun"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/thomasvandam/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/thomasvandam/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/thomasvandam/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/thomasvandam/google-cloud-sdk/completion.zsh.inc'; fi
